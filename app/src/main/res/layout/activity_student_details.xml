<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white"
    android:gravity="center_horizontal">

    <!-- Header with Name and Amount Details -->
    <TextView
        android:id="@+id/text_view_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:text="Student Name"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/text_view_advance_paid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textColor="#444444"
        android:text="Advance Paid: 0 Rs"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/text_view_available_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textColor="#444444"
        android:text="Available Balance: 0 Rs"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/text_view_due_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textColor="#444444"
        android:text="Due Amount: 0 Rs"
        android:layout_marginBottom="16dp"/>

    <!-- Date Selector -->
    <Button
        android:id="@+id/btn_select_date"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Select Date"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:background="@color/colorPrimary"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/text_view_selected_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="#444444"
        android:text="No date selected"
        android:layout_marginBottom="16dp"/>

    <!-- Food Options -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Food Options:"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="8dp"/>
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
    <CheckBox
        android:id="@+id/checkbox_lunch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lunch (20 Rs)"
        android:textSize="18sp"
        android:textColor="#333333"
        android:layout_marginBottom="8dp"/>

    <CheckBox
        android:id="@+id/checkbox_dinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dinner (20 Rs)"
        android:textSize="18sp"
        android:textColor="#333333"
        android:layout_marginBottom="8dp"/>

</LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Egg Options:"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp"
        android:padding="16dp"
        android:background="@drawable/rounded_background"> <!-- Optional background for aesthetic -->

        <!-- Poached Egg -->
        <LinearLayout
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

<!--            <ImageView-->
<!--                android:layout_width="24dp"-->
<!--                android:layout_height="24dp"-->
<!--                android:src="@drawable/ic_poached_egg" &lt;!&ndash; Add a suitable icon for poached egg &ndash;&gt;-->
<!--            android:layout_marginEnd="8dp" />-->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Poached Egg (2 Rs)"
                android:textSize="20sp"
                android:textColor="#333333"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/edittext_poached_qty"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textSize="18sp"
                android:textColor="#333333"
                android:background="@drawable/edittext_background"
            android:padding="8dp"
            android:layout_marginStart="16dp" />
        </LinearLayout>

        <!-- Omelette -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

<!--            <ImageView-->
<!--                android:layout_width="24dp"-->
<!--                android:layout_height="24dp"-->
<!--                android:src="@drawable/ic_omelette" &lt;!&ndash; Add a suitable icon for omelette &ndash;&gt;-->
<!--            android:layout_marginEnd="8dp" />-->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Omelette (5 Rs)"
                android:textSize="20sp"
                android:textColor="#333333"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/edittext_omelette_qty"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textSize="18sp"
                android:textColor="#333333"
                android:background="@drawable/edittext_background"
            android:layout_marginStart="16dp" />
        </LinearLayout>

        <!-- Boiled Egg -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

<!--            <ImageView-->
<!--                android:layout_width="60dp"-->
<!--                android:layout_height="60dp"-->
<!--                android:src="@drawable/boiled" -->
<!--            android:layout_marginEnd="8dp" />-->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Boiled Egg (6 Rs)"
                android:textSize="20sp"
                android:textColor="#333333"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/edittext_boiled_qty"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textSize="18sp"
                android:textColor="#333333"
                android:background="@drawable/edittext_background"
            android:padding="8dp"
            android:layout_marginStart="16dp" />
        </LinearLayout>
    <!-- Total Amount -->
    <TextView
        android:id="@+id/text_view_total_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total Amount: 0 Rs"
        android:textSize="22sp"
        android:textColor="#333333"
        android:layout_marginBottom="24dp"/>

    <!-- Update Button -->
    <Button
        android:id="@+id/btn_update_amount"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Update Amount"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:background="@color/colorPrimary"/>

</LinearLayout>
</LinearLayout>