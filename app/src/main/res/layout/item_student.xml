<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/rounded_background" >

<TextView
android:id="@+id/text_view_name"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Student Name"
android:textSize="20sp"
android:textColor="#333333"
android:textStyle="bold"
android:layout_marginBottom="8dp" />

    <!-- Amount Due -->
<TextView
android:id="@+id/text_view_amount"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Amount Due"
android:textSize="16sp"
android:textColor="#555555"
android:layout_marginBottom="4dp" />

    <!-- Advance Paid -->
<TextView
android:id="@+id/text_view_advance_paid"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Advance Paid"
android:textSize="16sp"
android:textColor="#555555"
android:layout_marginBottom="4dp" />

    <!-- Available Balance -->
<TextView
android:id="@+id/text_view_available_balance"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Available Balance"
android:textSize="16sp"
android:textColor="#555555"
android:layout_marginBottom="8dp" />

    <!-- Buttons for Edit and Delete -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:gravity="end"
android:layout_marginTop="8dp">

<Button
    android:id="@+id/button_edit"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Edit"
    android:textColor="#FFFFFF"
    android:background="@drawable/button_edit_background"
android:layout_marginEnd="8dp"
android:padding="12dp"
android:textSize="16sp"
android:layout_gravity="end" />

<Button
    android:id="@+id/button_delete"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Delete"
    android:textColor="#FFFFFF"
    android:background="@drawable/button_delete_background"
android:padding="12dp"
android:textSize="16sp"
android:layout_gravity="end" />
</LinearLayout>
    </LinearLayout>
